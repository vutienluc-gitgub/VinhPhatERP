
echo "📦 Checking Root package-lock.json sync..."
npm ci --dry-run || { echo "❌ Root package-lock.json is out of sync! Run 'npm install'."; exit 1; }

echo "📦 Checking Server package-lock.json sync..."
(cd server && npm ci --dry-run) || { echo "❌ Server package-lock.json is out of sync! Run 'cd server && npm install'."; exit 1; }

echo "🔍 Checking RPC sync..."
npm run rpc:check || exit 1

echo "🛡️ Running Full System Audit..."
npm run audit:full || exit 1

echo "🚀 Running AI Audit before push..."
npm run ai:audit || exit 1

echo "⚡ Running Unit & Integration Tests (Vitest)..."
npm test || exit 1

echo "🧪 Running E2E Tests before push..."
npm run test:e2e || exit 1

echo "✅ Push allowed."