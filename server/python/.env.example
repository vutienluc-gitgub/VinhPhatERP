# VinhPhatERP Yarn Document Intelligence Pipeline (.env)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
LOG_LEVEL=INFO

# Gate 0 Thresholds
MIN_RESOLUTION=800
MIN_BLUR_SCORE=100.0
MIN_BRIGHTNESS=40.0
MAX_BRIGHTNESS=240.0

# Mathematical Validation Tolerances (in kg)
SCALE_PRECISION_KG=0.10
DOCUMENT_TOLERANCE_KG=0.15
PACKAGE_TOLERANCE_KG=0.05

# Self-Healing Configuration
MAX_CORRECTION_ATTEMPTS=1
