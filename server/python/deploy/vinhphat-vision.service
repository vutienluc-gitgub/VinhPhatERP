[Unit]
Description=VinhPhatERP Vision Intelligence Microservice
After=network.target

[Service]
Type=simple
User=vinhphat
Group=vinhphat
WorkingDirectory=/opt/vinhphat-erp/server/python
Environment="PATH=/opt/vinhphat-erp/server/python/.venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=/opt/vinhphat-erp/server/python/.env
ExecStart=/opt/vinhphat-erp/server/python/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2

Restart=always
RestartSec=5s
LimitNOFILE=65536

# Sandboxing & Hardening
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
