# VinhPhat API Server — biến môi trường
# Copy file này thành .env và điền giá trị thực

# PostgreSQL connection string (lấy từ Supabase > Settings > Database)
# LƯU Ý: dùng SESSION POOLER (port 5432) — host cũ db.<ref>.supabase.co đã bị khai tử.
# Nếu mật khẩu chứa ký tự đặc biệt (@ # : /) phải URL-encode, ví dụ @ → %40
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@103.213.216.31:5432/postgres
# Supabase (Self-hosted on VPS)
SUPABASE_URL=https://quantri.detmayvinhphat.com
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Server
PORT=3000

ALLOWED_ORIGINS=http://localhost:5173

# Bí mật ký JWT Supabase-compatible (HS256) cho phiên Passkey.
# Phải TRÙNG với `JWT_SECRET` của GoTrue self-hosted. Lấy giá trị đang dùng
# trong supabase/docker/.env trên VPS rồi đặt vào đây.
# KHÔNG có giá trị mặc định: thiếu biến này → passkey login trả 503 và
# getJwtSecret() sẽ throw, tuyệt đối không dùng secret công khai nào.
SUPABASE_JWT_SECRET=

# Thời hạn refresh token cho phiên Passkey (ngày). Mặc định 30 nếu bỏ trống.
# Access token vẫn 7 ngày; refresh token cho phép gia hạn không cần quét sinh
# trắc học lại, và được xoay vòng (rotation) mỗi lần dùng.
PASSKEY_REFRESH_TTL_DAYS=30

# Webhook & Push Security (HMAC-SHA256 & VAPID)
WEBHOOK_SECRET=your_64_char_hex_secret
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@detmayvinhphat.com

# Vision Microservice (:8000)
INTERNAL_VISION_SERVICE_URL=http://127.0.0.1:8000
INTERNAL_VISION_SERVICE_KEY=dev-vinhphat-secret-key-change-in-prod


